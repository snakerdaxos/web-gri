# Copy to .env and set real values. .env is gitignored.
# docker-compose.yml interpolates these ${VARS} into both mysql and api services.
MYSQL_ROOT_PASSWORD=replace-me-root
MYSQL_APP_PASSWORD=replace-me-app
DEMO_MODE=false

# --- Phase 2: auth + tenancy ---
# JWT signing secret. MUST be a strong random value in prod (Phase 9).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# Bootstrap super-admin (created on first startup if absent; idempotent).
# Email must be unique; password should be rotated after first login in prod.
SUPER_ADMIN_EMAIL=admin@gri.dev
SUPER_ADMIN_PASSWORD=replace-me-change-immediately

# --- Phase 4/5: CORS ---
# Comma-separated browser origins allowed to call the API with credentials.
# Explicit origins ONLY (allow_credentials=True forbids "*").
# Dev: the Flutter Web panel runs on http://localhost:5173 (Phase 4, pinned
# --web-port) and the app cliente runs on http://localhost:5174 (Phase 5).
# Phase 9 prod: the panel's HTTPS domain, e.g. CORS_ORIGINS=https://panel.gri.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Phase 9: pagos Wompi ---
# Dev: SANDBOX_MODE=true monta /pagos/sandbox/* (checkout local que ejercita
# el MISMO pipeline del webhook con eventos firmados localmente).
# Prod (tras KYC): SANDBOX_MODE=false + las 4 keys reales de Wompi. La API
# advierte en el log si SANDBOX_MODE queda true con ENVIRONMENT=production.
SANDBOX_MODE=true
WOMPI_PUBLIC_KEY=pub_test_dev
WOMPI_PRIVATE_KEY=prv_test_dev
# Firma del webhook (dev default exacto "dev-events-secret" — los tests lo usan).
WOMPI_EVENTS_SECRET=dev-events-secret
# Firma de integridad del checkout (SHA256 concat plana — 09-RESEARCH).
WOMPI_INTEGRITY_SECRET=dev-integrity-secret

# DB_HOST / DB_PORT / DB_USER / DB_NAME are set in docker-compose.yml for the
# api container (DB_HOST=mysql is the docker DNS name of the mysql service).
# For local non-Docker dev against MySQL on host: set DB_HOST=127.0.0.1 in
# a backend/.env or export them in your shell before `uv run uvicorn ...`.
