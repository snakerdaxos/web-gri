# Plantilla de configuracion de las Cloud Functions de GRI.
#
# El archivo REAL es `functions/.env` y NO se commitea (esta en .gitignore raiz
# y en functions/.gitignore): contiene los valores de PRODUCCION.
#
# Para emuladores no hace falta copiar nada: firebase-tools carga tambien
# `functions/.env.{projectId}` y `functions/.env.demo-gri` YA esta versionado
# con valores ficticios deterministas.
#
# Copiar a `functions/.env` y rellenar antes de desplegar:
#   cp functions/.env.example functions/.env

# Correo del primer super_admin que creara la funcion de bootstrap (plan 11-07).
BOOTSTRAP_EMAIL=

# Secreto que debe presentar quien invoca el bootstrap. Sin el, la callable
# rechaza la llamada. Debe ser largo y aleatorio. NUNCA reutilizar el de demo.
BOOTSTRAP_SECRET=
