rules_version = '2';

// ============================================================================
// GRI — Firestore Security Rules (Phase 10, Opción B)
//
// Reemplazo declarativo de TenantScope + require_roles (backend FastAPI).
// La autorización es 100% por custom claims { role, rid } que viajan en
// request.auth.token (los setea SOLO scripts/seed_firebase.mjs con Admin SDK).
// El doc usuarios/{uid} es un ESPEJO de perfil: JAMÁS autoriza — ninguna regla
// hace get() sobre usuarios/ (presupuesto de access-calls + anti-desync).
//
// Presupuesto de access-calls (límite: 10 por request de doc único, 20 por
// multi-doc/tx; gets repetidos al mismo doc cuentan 1 vez — cacheado):
//   sesiones create      → 1 doc (mesas)             = 1 access-call
//   pedidos create       → 2 docs (sesiones, mesas)  = 2 access-calls (3 gets)
//   reservas create      → 1 doc (mesas)             = 1 access-call
//   calificaciones create→ 2 docs (pedidos, sesiones)= 2 access-calls (4 gets)
// Máximo 3 por match. NO agregar más gets "por seguridad".
//
// Transiciones de mesa = MESA_TRANSITIONS de backend/app/core/state_machines.py
// (disponible→[reservada,ocupada], reservada→[ocupada,disponible],
//  ocupada→[limpieza], limpieza→[disponible]).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers de claims (0 access-calls — todo vive en el token) ----

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function rid() {
      return request.auth.token.rid;
    }

    function isSuper() {
      return signedIn() && role() == 'super_admin';
    }

    // Auto-registrado no tiene claim role → se trata como cliente.
    function isCliente() {
      return signedIn()
        && (!('role' in request.auth.token) || request.auth.token.role == 'cliente');
    }

    // Staff (admin/mesero/cocina) DEL restaurante indicado.
    function staffOf(r) {
      return signedIn() && r == rid()
        && role() in ['admin_restaurante', 'mesero', 'cocina'];
    }

    // ---- opStaffOf: quien OPERA la sala (11-34) --------------------------
    //
    // POR QUÉ EXISTE. `staffOf()` exige `r == rid()` y un rol de la lista, y
    // el `super_admin` no cumple NINGUNA de las dos: no tiene `rid`
    // (seed_firebase.mjs:47) y su rol no está en la lista. Resultado
    // REPRODUCIDO por el usuario operando de verdad como super: pulsar
    // «entregar cuenta» devolvía `permission-denied` en el commit que escribe
    // `sesiones/{id}.estado = 'cerrada'` + `mesas/{id}.estado = 'limpieza'`.
    // Lo mismo con cambiar el estado de una mesa y con cancelar una reserva
    // por no-show. La auditoría de reglas (11-04) ya había marcado la
    // asimetría —`pedidos` SÍ contempla `isSuper()` con `cocinaStaffOf`, el
    // resto no— y nadie la tropezó hasta operar la sala.
    //
    // QUÉ CONCEDE, EXACTAMENTE: al `super_admin` las TRES operaciones de sala
    // que ya podía OBSERVAR (las tres ramas de `read` de `sesiones`, `mesas` y
    // `reservas` llevan `isSuper()` desde el día uno): cerrar/expirar una
    // sesión, mover el estado de una mesa por la máquina de transiciones, y
    // cancelar una reserva. NO concede ni un campo nuevo: las mismas
    // restricciones de forma (`soloEstado`, `transMesa`, estado destino) se
    // evalúan igual para él que para el staff.
    //
    // QUÉ NO CONCEDE: nada sobre `usuarios` (el padrón sigue con su propia
    // regla), nada sobre `plataforma` (deny total, incluido el super), y no
    // convierte al super en cliente (no puede abrir sesiones ni crear
    // pedidos/reservas: esas ramas son `isCliente()` y él tiene claim `role`).
    //
    // NOTA DE PRODUCTO (decisión del usuario 2026-08-20): hoy el usuario es
    // dueño de la plataforma Y operador del restaurante. Si algún día hubiera
    // restaurantes de dueños distintos, lo correcto sería lo contrario —
    // revertir es sustituir `opStaffOf` por `staffOf` en los tres sitios.
    function opStaffOf(r) {
      return isSuper() || staffOf(r);
    }

    // Quien administra el menú/fichas: super o admin del restaurante.
    function menuStaffOf(r) {
      return signedIn() && (isSuper()
        || (r == rid() && role() == 'admin_restaurante'));
    }

    // Quien avanza pedidos en cocina: super, admin, cocina o mesero (servir).
    function cocinaStaffOf(r) {
      return signedIn() && (isSuper()
        || (r == rid() && role() in ['admin_restaurante', 'cocina', 'mesero']));
    }

    // Update que solo toca estado + updatedAt (cambios de estado).
    function soloEstado() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['estado', 'updatedAt']);
    }

    // MESA_TRANSITIONS 1:1 de backend/app/core/state_machines.py.
    function transMesa(a, b) {
      return (a == 'disponible' && b in ['reservada', 'ocupada'])
          || (a == 'reservada'  && b in ['ocupada', 'disponible'])
          || (a == 'ocupada'    && b == 'limpieza')
          || (a == 'limpieza'   && b == 'disponible');
    }

    // ---- NOTA TRANSVERSAL (11-27) — LEER ANTES DE TOCAR CUALQUIER `read` ----
    //
    // Una rama de `read` que desreferencia `resource.data` DENIEGA los
    // documentos QUE NO EXISTEN. Sobre un doc ausente `resource` es null, la
    // expresion revienta y la regla evalua a denegado: el SDK devuelve
    // `permission-denied`, NO "no encontrado". Es indistinguible de un fallo
    // de autorizacion y por eso costo un P0 completo.
    //
    // GRI usa check-then-create en CUATRO sitios (el doc ID es determinista y
    // se lee antes de escribirlo):
    //   sesiones/{mesaId}          abrirSesion()   — sesion_provider.dart
    //   reservas/{mesa}_{fecha}_{H} crearReserva() — reserva_controller.dart
    //   mesas/{GRI-MESA-rid-NNN}   crearMesa()     — mesas_crud.dart
    //   calificaciones/{pedidoId}  _calificar()    — calificacion_sheet.dart
    // Los dos primeros estaban ROTOS: nadie podia abrir una mesa ni reservar,
    // NUNCA, porque la primera lectura es siempre sobre un doc ausente.
    //
    // Donde haga falta, la forma correcta es `signedIn() && (resource == null
    // || <condicion>)` — NUNCA `resource == null || (signedIn() && ...)`, que
    // dejaria a los anonimos sondear la coleccion. Solo concede aprender que
    // "aqui no hay nada"; el CONTENIDO sigue exactamente igual de protegido.
    // Cobertura: los bloques `read de un doc AUSENTE` de las 9 suites de
    // scripts/test/rules/.

    // ---- restaurantes (descubrimiento público) · 0 access-calls ----
    match /restaurantes/{restId} {
      // Lista pública (la query del cliente filtra activo == true).
      allow read: if true;
      allow create, delete: if isSuper();
      // super: SOLO toggle de activo (paridad PLAT-05). Cliente: SOLO el
      // agregado califProm/califCount que mantiene la tx de calificar.
      // (Un update standalone de esas 2 keys sin calificación real es un gap
      //  estructural aceptado en v1 — validación fuerte = Functions, DEFERRED.)
      allow update: if (isSuper()
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['activo']))
                    || (isCliente()
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['califProm', 'califCount'])
                        && request.resource.data.califProm is number
                        && request.resource.data.califCount is int);
    }

    // ---- categorias (menú) · 0 access-calls ----
    // OJO (rules por-doc en queries): la query pública DEBE filtrar
    // activo == true o un solo doc inactivo deniega toda la query.
    match /categorias/{categoriaId} {
      allow read: if resource.data.activo == true
                  || menuStaffOf(resource.data.restauranteId);
      // create valida contra el doc ENTRANTE (aún no existe resource).
      allow create: if menuStaffOf(request.resource.data.restauranteId);
      allow update: if menuStaffOf(resource.data.restauranteId)
                    && request.resource.data.restauranteId
                       == resource.data.restauranteId;
      // delete valida contra el doc EXISTENTE (request.resource es null).
      allow delete: if menuStaffOf(resource.data.restauranteId);
    }

    // ---- productos (menú) · 0 access-calls ----
    // Query pública: filtrar activo == true AND disponible == true (por-doc).
    match /productos/{productoId} {
      allow read: if (resource.data.activo == true
                      && resource.data.disponible == true)
                  || menuStaffOf(resource.data.restauranteId);
      allow create: if menuStaffOf(request.resource.data.restauranteId);
      allow update: if menuStaffOf(resource.data.restauranteId)
                    && request.resource.data.restauranteId
                       == resource.data.restauranteId;
      allow delete: if menuStaffOf(resource.data.restauranteId);
    }

    // ---- mesas (doc ID = código QR "GRI-MESA-{rid}-{num}") · 0 access-calls ----
    match /mesas/{mesaId} {
      // Leer la mesa no es sensible: staff la vigila y el cliente la abre
      // tras escanear el QR.
      allow read: if signedIn();
      // create contra el doc ENTRANTE; delete contra el doc EXISTENTE
      // (request.resource es null en delete — usar resource).
      allow create: if menuStaffOf(request.resource.data.restauranteId);
      allow delete: if menuStaffOf(resource.data.restauranteId);
      // Edición de ficha (numero/capacidad): sin tocar estado, sin mover
      // la mesa de restaurante.
      allow update: if menuStaffOf(resource.data.restauranteId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['numero', 'capacidad', 'updatedAt'])
                    && request.resource.data.restauranteId
                       == resource.data.restauranteId;
      // Cambio de estado por staff (mapa de mesas / mesero): solo
      // estado+updatedAt con transición válida.
      // `opStaffOf` y no `staffOf` (11-34): el super_admin opera la sala.
      allow update: if opStaffOf(resource.data.restauranteId)
                    && soloEstado()
                    && transMesa(resource.data.estado,
                                 request.resource.data.estado);
      // Cambio de estado por CLIENTE dentro de sus dos transacciones
      // diseñadas: tx de reserva (disponible→reservada) y tx de abrir
      // sesión (disponible|reservada→ocupada).
      allow update: if isCliente()
                    && soloEstado()
                    && ((resource.data.estado == 'disponible'
                         && request.resource.data.estado == 'reservada')
                     || (resource.data.estado in ['disponible', 'reservada']
                         && request.resource.data.estado == 'ocupada'));
    }

    // ---- usuarios (espejo de perfil — NUNCA autoriza) · 0 access-calls ----
    match /usuarios/{uid} {
      // AMPLIADO EN 11-10 (gestión de equipo del panel). Antes: solo el propio
      // usuario o el super_admin. Sin la tercera rama un `admin_restaurante` no
      // puede LISTAR su propio equipo y la pantalla /equipo NO PUEDE EXISTIR:
      // el restaurante seguiría dependiendo de un script con clave de servicio
      // para saber quién trabaja en él.
      //
      // QUÉ CONCEDE, EXACTAMENTE: leer los docs de `usuarios` cuyo
      // `restauranteId` sea el rid del llamador, y SOLO al rol
      // `admin_restaurante` — ni mesero ni cocina, que no gestionan personal.
      // Los CLIENTES quedan fuera por construcción (`restauranteId == null`
      // nunca iguala a un rid), así que esto no abre el padrón de clientes:
      // la tabla de clientes del panel se sigue plegando desde `pedidos`.
      //
      // ⚠️ LA QUERY DEL PANEL DEBE REPLICAR EL FILTRO. Firestore evalúa las
      // rules contra la CONSULTA, no contra los documentos devueltos: sin
      // `where('restauranteId', isEqualTo: rid)` la lista se deniega ENTERA
      // aunque todos los docs fueran legibles. Es el mismo modo de fallo del
      // bug del menú (11-03) y lo vigila `scripts/audit_indexes.mjs`
      // (tabla PARIDAD_RULES_QUERY, entrada `usuarios`).
      //
      // Presupuesto de access-calls INTACTO: la rama no hace ningún `get()`.
      // El doc espejo `usuarios/{uid}` sigue sin autorizar NADA — el rid y el
      // rol del llamador salen del token, no del documento leído.
      allow read: if signedIn() && (request.auth.uid == uid
                                    || isSuper()
                                    || (role() == 'admin_restaurante'
                                        && resource.data.restauranteId == rid()));
      // Auto-registro: SOLO cliente y sin restaurante. El rol real viaja en
      // claims (el cliente no puede auto-ascenderse a staff).
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'cliente'
                    && request.resource.data.restauranteId == null;
      // El propio usuario solo puede cambiar su nombre; role y
      // restauranteId quedan congelados (los cambia el seed/Admin SDK).
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['nombre']);
      allow delete: if false;
    }

    // ---- sesiones (doc ID = mesaId → UNA sesión por mesa) · create 1 access-call ----
    match /sesiones/{sesionId} {
      // `resource == null` (11-27): la mesa que AUN NO tiene sesion. Es el
      // `tx.get(sesiones/{codigoQR})` con el que abrirSesion() averigua si la
      // mesa esta ocupada ANTES de crear la sesion — la primera apertura de
      // CUALQUIER mesa lee un doc ausente. Sin esto no se puede abrir ninguna
      // mesa: el core value del producto. Concede solo saber que no hay sesion
      // abierta en una mesa cuyo codigo va IMPRESO en su propio QR.
      allow read: if signedIn() && (resource == null
                  || resource.data.usuarioId == request.auth.uid
                  || staffOf(resource.data.restauranteId) || isSuper());
      // set() sobre doc existente se evalúa como UPDATE: "re-abrir" una
      // sesión cerrada queda bloqueado ex profeso (no pasa por create).
      allow create: if isCliente()
                    && request.resource.data.estado == 'activa'
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.cuentaSolicitada == false
                    && request.resource.data.mesaId == sesionId
                    && get(/databases/$(database)/documents/mesas/$(sesionId)).data.estado
                       in ['disponible', 'reservada']              // 1 access-call
                    && get(/databases/$(database)/documents/mesas/$(sesionId)).data.restauranteId
                       == request.resource.data.restauranteId;     // mismo doc: cacheado
      // ── RAMA DEL COMENSAL: pedir la cuenta y REABRIRLA (11-34) ─────────
      //
      // ANTES la condición era `request.resource.data.cuentaSolicitada ==
      // true`: solo se podía ENCENDER la bandera. Apagarla estaba DENEGADO, y
      // eso dejaba la mesa en un estado sin salida, reproducido por el
      // usuario: pidió la cuenta, después pidió un café, el pedido nuevo se
      // aceptó pero no entraba en el total (solo se cobra lo `servido`) y el
      // botón de pedir la cuenta ya no volvía, porque la bandera seguía en
      // true. El mesero, además, tenía en su lista un importe viejo.
      //
      // DECISIÓN DEL USUARIO (2026-08-20): se REABRE la cuenta. Al crear un
      // pedido con la sesión en `cuentaSolicitada: true`, la misma
      // transacción apaga la bandera; el botón vuelve y el aviso al mesero se
      // rehace cuando el comensal la pida otra vez.
      //
      // QUÉ CONCEDE ESTA AMPLIACIÓN, EXACTAMENTE: que el DUEÑO de una sesión
      // ACTIVA retire SU PROPIA solicitud de cuenta. Nada más. No puede
      // cerrar la sesión, ni tocar importes (no hay ninguno en este doc), ni
      // rozar otra mesa. Retirar una petición que hizo él es su derecho: el
      // caso de uso literal es «espera, que pido un café».
      //
      // LOS TRES CANDADOS QUE LA ACOTAN (los tres tienen su caso en
      // scripts/test/rules/sesiones.test.mjs → «update — reabrir la cuenta»):
      //   1. `resource.data.estado == 'activa'` — sobre una sesión CERRADA no
      //      se toca nada. Esto es MÁS ESTRICTO que la regla anterior, que
      //      dejaba encender la bandera en una sesión ya cerrada.
      //   2. `resource.data.cuentaSolicitada == true` — solo se apaga lo que
      //      estaba encendido. Un update a false sobre una sesión que nunca
      //      pidió la cuenta es ruido y queda denegado.
      //   3. `cuentaPedidaAt` DEBE quedar en null — no se puede apagar la
      //      bandera conservando la marca de tiempo vieja, que es justo el
      //      estado inconsistente del que se sale ('no pidió la cuenta' pero
      //      'la pidió a las 20:14').
      //
      // `.get('cuentaPedidaAt', null)`: el cliente puede mandar `null` o un
      // `FieldValue.delete()`; con delete la clave NO está en
      // `request.resource.data` y desreferenciarla directamente reventaría la
      // regla (denegando por el motivo equivocado). Sigue contando en
      // `affectedKeys()`, así que `hasOnly` la vigila igual.
      allow update: if (resource.data.usuarioId == request.auth.uid
                        && resource.data.estado == 'activa'
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['cuentaSolicitada', 'cuentaPedidaAt'])
                        && (request.resource.data.cuentaSolicitada == true
                            || (resource.data.cuentaSolicitada == true
                                && request.resource.data.cuentaSolicitada == false
                                && request.resource.data.get('cuentaPedidaAt', null) == null)))
                    || (opStaffOf(resource.data.restauranteId)      // staff cierra/expira
                        && soloEstado()
                        && resource.data.estado == 'activa'
                        && request.resource.data.estado
                           in ['cerrada', 'expirada']);
      allow delete: if false;
    }

    // ---- pedidos · create 2 access-calls (3 gets, sesiones cacheado) ----
    match /pedidos/{pedidoId} {
      // `resource == null` (11-27): mismo defecto que sesiones/reservas. Aqui
      // no habia check-then-create (los ids son autoId) pero SI codigo que ya
      // dependia de leer el hueco y era inalcanzable: la rama
      // `if (!pedidoSnap.exists) throw 'Pedido no encontrado'` de _calificar()
      // moria antes con permission-denied. Con autoId de 20 caracteres, saber
      // "existe o no" no es enumerable ni revela nada.
      allow read: if signedIn() && (resource == null
                  || resource.data.usuarioId == request.auth.uid
                  || staffOf(resource.data.restauranteId) || isSuper());
      // Snapshot de nombre/precio embebido por item (gap estructural v1:
      // sin backend no hay validación fuerte de totales — Functions DEFERRED).
      allow create: if isCliente()
                    && request.resource.data.estado == 'enviado'
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.sesionId
                       == request.resource.data.mesaId
                    && get(/databases/$(database)/documents/sesiones/$(request.resource.data.sesionId)).data.usuarioId
                       == request.auth.uid   // sesión PROPIA (anti-spoofing Phase 6)
                    && get(/databases/$(database)/documents/sesiones/$(request.resource.data.sesionId)).data.estado
                       == 'activa'           // sesión ACTIVA
                    && get(/databases/$(database)/documents/mesas/$(request.resource.data.mesaId)).data.restauranteId
                       == request.resource.data.restauranteId  // tenant consistente
                    && request.resource.data.items is list
                    && request.resource.data.items.size() >= 1
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is int
                    && request.resource.data.total >= 0;
      // Avance de cocina: solo estado+updatedAt + matriz rol×transición
      // (port de la matriz Phase 6). 'pagado' es inalcanzable en v1.
      allow update: if cocinaStaffOf(resource.data.restauranteId)
                    && soloEstado()
                    && ((resource.data.estado == 'enviado'
                         && request.resource.data.estado
                            in ['aceptado', 'rechazado']
                         && (role() in ['admin_restaurante', 'cocina']
                             || isSuper()))
                     || (resource.data.estado == 'aceptado'
                         && request.resource.data.estado == 'en_preparacion'
                         && (role() in ['admin_restaurante', 'cocina']
                             || isSuper()))
                     || (resource.data.estado == 'en_preparacion'
                         && request.resource.data.estado == 'servido'));
      allow delete: if false;
    }

    // ---- reservas (doc ID {mesaId}_{yyyyMMdd}_{HH} → 1 por slot) · create 1 access-call ----
    match /reservas/{reservaId} {
      // `resource == null` (11-27): el SLOT LIBRE. crearReserva() recorre las
      // mesas candidatas haciendo `tx.get(reservas/{mesaId}_{fecha}_{HH})` y
      // ELIGE la primera que no existe — leer el hueco no es un accesorio del
      // flujo, ES el flujo. Concede solo saber que una franja esta libre: la
      // disponibilidad que cualquier sistema de reservas publica por diseno.
      allow read: if signedIn() && (resource == null
                  || resource.data.usuarioId == request.auth.uid
                  || staffOf(resource.data.restauranteId) || isSuper());
      allow create: if isCliente()
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.estado == 'confirmada'
                    // MARGEN MINIMO DE 4 HORAS (11-31, decision del usuario
                    // 2026-08-20). Antes bastaba con que el slot fuera futuro,
                    // asi que se podia reservar para dentro de un minuto. El
                    // cliente ya no lo ofrece, pero si el margen vive SOLO en
                    // el cliente es decoracion: cualquiera con un token de
                    // cliente escribe el doc a mano.
                    //
                    // HUSO HORARIO: `fecha` es un Timestamp (instante
                    // absoluto, lo escribe `Timestamp.fromDate(slot)` con el
                    // slot en hora local del dispositivo) y `request.time`
                    // tambien lo es (UTC). Comparar dos instantes absolutos no
                    // depende del huso: no hay conversion que hacer ni que
                    // olvidar. America/Bogota (UTC-5, sin horario de verano)
                    // solo importa para la hora de PARED del slot y para el
                    // `yyyyMMdd` del doc ID, que aqui no se evaluan.
                    //
                    // `request.time` es el instante en que el servidor recibe
                    // la escritura, POSTERIOR al `DateTime.now()` con el que
                    // decidio el cliente. El servidor es por tanto la
                    // evaluacion autoritativa y un pelo mas estricta.
                    && request.resource.data.fecha
                       >= request.time + duration.value(4, 'h')
                    && request.resource.data.numPersonas >= 1
                    && request.resource.data.numPersonas <= 20
                    && get(/databases/$(database)/documents/mesas/$(request.resource.data.mesaId)).data.restauranteId
                       == request.resource.data.restauranteId      // 1 access-call
                    && request.resource.data.numPersonas
                       <= get(/databases/$(database)/documents/mesas/$(request.resource.data.mesaId)).data.capacidad;
                       // capacidad restaurada server-side (mismo doc: cacheado)
      // Cancelar: dueño (futura) o staff (no-show). Solo estado+updatedAt.
      // `opStaffOf` y no `staffOf` (11-34): el super_admin opera la sala.
      // Cancelar la reserva es además, desde 11-34, LO QUE LIBERA LA MESA —
      // el mapa deriva el color de las reservas del día, así que una reserva
      // cancelada deja de teñir la mesa en el acto.
      allow update: if soloEstado()
                    && request.resource.data.estado == 'cancelada'
                    && ((resource.data.usuarioId == request.auth.uid
                         && resource.data.fecha > request.time)
                     || opStaffOf(resource.data.restauranteId));
      allow delete: if false;
    }

    // ---- calificaciones (doc ID = pedidoId → 1:1) · create 2 access-calls (4 gets) ----
    match /calificaciones/{pedidoId} {
      allow read: if true;  // visible en discover
      allow create: if isCliente()
                    && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.usuarioId
                       == request.auth.uid      // pedido PROPIO
                    && get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.estado
                       == 'servido'             // pedido SERVIDO
                    && get(/databases/$(database)/documents/sesiones/$(get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.sesionId)).data.estado
                       == 'cerrada'             // sesión CERRADA (pagos diferidos)
                    && request.resource.data.pedidoId == pedidoId
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.restauranteId
                       == get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.restauranteId
                    && request.resource.data.estrellas is int
                    && request.resource.data.estrellas >= 1
                    && request.resource.data.estrellas <= 5;
      allow update, delete: if false;  // inmutable
    }

    // ---- plataforma (centinela de bootstrap) · 0 access-calls ----
    // Solo el Admin SDK (que salta las rules) lo toca, desde la callable
    // `bootstrapPlataforma` (functions/src/bootstrap-plataforma.js).
    // Ningun cliente —ni siquiera el super_admin— debe poder leerlo ni
    // borrarlo: borrarlo RE-ABRIRIA el bootstrap y con el la puerta a un
    // segundo super_admin (T-11-07-04).
    // El bloque "colecciones no declaradas — default deny" de
    // scripts/test/rules/restaurantes.test.mjs (plan 11-04) se escribio ANTES
    // que esta regla y debe seguir en verde con ella.
    match /plataforma/{doc} { allow read, write: if false; }
  }
}
