# =============================================================================
# GRI — plantilla de secretos de PRODUCCIÓN (Phase 9).
#
#   cp .env.production.example .env.production   → editar TODOS los valores.
#
# .env.production está en .gitignore: JAMÁS commitear este archivo con valores
# reales (esta plantilla con placeholders SÍ se commitea).
# Se consume con --env-file explícito:
#   docker compose --env-file .env.production -f deploy/docker-compose.prod.yml up -d --build
# =============================================================================

# --- MySQL (contenedor gri-prod-mysql) ---------------------------------------
# Generar cada uno con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (sin comillas, sin $ ni espacios — token_urlsafe es URL-safe)
MYSQL_ROOT_PASSWORD=CAMBIAR-generar-con-secrets-token-urlsafe
MYSQL_APP_PASSWORD=CAMBIAR-generar-con-secrets-token-urlsafe

# --- Flags de producción (POLÍTICA — ver comentarios) ------------------------
# DEMO_MODE: prod JAMÁS true. El seed demo (restaurante+staff de prueba) NO
# debe existir en producción. Además el compose prod lo deja hardcodeado
# "false" (defense-in-depth: este valor mal editado no re-activa el seed).
DEMO_MODE=false

# SANDBOX_MODE: prod SIEMPRE false. Con false las rutas /pagos/sandbox/* NO
# existen (404 real — montaje condicional) y la única vía de pago es el
# webhook REAL de Wompi. Mientras el KYC no esté aprobado y no haya keys
# reales abajo, el flujo de pago queda DESHABILITADO en prod (sin checkout):
# es el estado seguro. Solo false — JAMÁS true en producción (cualquiera
# podría "aprobar" pagos sin dinero). El compose prod lo hardcodea "false".
SANDBOX_MODE=false

# --- Auth / JWT ----------------------------------------------------------------
# Firma HS256 de TODOS los tokens. OBLIGATORIO un valor fuerte y único:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ADVERTENCIA: con un secret débil/filtrado cualquiera forja tokens de
# super-admin. Generarlo una vez y guardarlo en un gestor de secretos.
JWT_SECRET=CAMBIAR-generar-con-secrets-token-urlsafe-48

# Bootstrap super-admin (se crea idempotente en el primer boot si no existe).
# Email único; ROTAR el password tras el primer login.
SUPER_ADMIN_EMAIL=admin@tu-dominio.com
SUPER_ADMIN_PASSWORD=CAMBIAR-generar-con-secrets-token-urlsafe

# --- CORS -----------------------------------------------------------------------
# Orígenes browser con credenciales, separados por coma, NUNCA "*". Con el
# routing same-origin de nginx el panel NO necesita CORS (misma origen), pero
# se setea igual como defensa + para la app cliente en web dev si aplica.
# TODO-reemplazar por el dominio real:
CORS_ORIGINS=https://gri.example.com

# --- Wompi (placeholders HASTA que el KYC esté aprobado — POST-fase) -----------
# Con SANDBOX_MODE=false y estas keys test, el gateway Wompi queda inerte
# (no hay flujo de pago activo). Al obtener credenciales REALES (dashboard
# Wompi merchant): reemplazar las 4, mantener SANDBOX_MODE=false y configurar
# el webhook https://{dominio}/webhooks/pago en el dashboard (README §12).
WOMPI_PUBLIC_KEY=pub_test_placeholder-hasta-kyc
WOMPI_PRIVATE_KEY=prv_test_placeholder-hasta-kyc
# Firma del webhook (verificación timing-safe en /webhooks/pago).
WOMPI_EVENTS_SECRET=events-placeholder-hasta-kyc
# Firma de integridad del checkout (SHA256 concat — 09-RESEARCH).
WOMPI_INTEGRITY_SECRET=integrity-placeholder-hasta-kyc
